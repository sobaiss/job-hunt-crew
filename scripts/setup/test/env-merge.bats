#!/usr/bin/env bats
# Tests for scripts/setup/env-merge.sh (#259). Each test builds a throwaway
# repo root (.env.example, .env, legacy per-package files) in a temp dir and
# runs the merge against it with --root. Run with `make test-setup`.

MERGE="$BATS_TEST_DIRNAME/../env-merge.sh"

setup() {
  ROOT="$BATS_TEST_TMPDIR/repo"
  mkdir -p "$ROOT/apps/web" "$ROOT/packages/prisma"
  cat >"$ROOT/.env.example" <<'EOF'
# Header comment.

# === Required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db"

# === Generated by setup
AUTH_SECRET="dev-auth-secret-change-me"
INTERNAL_API_SECRET="dev-internal-api-secret"
SETTINGS_ENCRYPTION_KEY=""

# === Optional
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=""
EMAIL_FROM="Job Hunt Crew <no-reply@example.local>"
AUTH_GOOGLE_ID=""

# === Advanced
# Ceiling on offers.
# INGESTION_MAX_OFFERS=25
EOF
}

merge() {
  run "$MERGE" --root "$ROOT" "$@"
}

# The value of KEY in the merged .env, quotes stripped, by sourcing it the
# way the Makefile does.
value_of() {
  ( set -a; . "$ROOT/.env"; eval "printf '%s' \"\${$1-<unset>}\"" )
}

full_env() {
  cat >"$ROOT/.env" <<'EOF'
DATABASE_URL="postgresql://u:p@db:5432/mine"
AUTH_SECRET="my-auth-secret"
INTERNAL_API_SECRET="my-internal-secret"
SETTINGS_ENCRYPTION_KEY="9Jm0lZb1V8V2dHq6cP3Rk6m9X0u4oJ7c2rTq5H8wYxA="
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=""
EMAIL_FROM="Me <me@example.org>"
AUTH_GOOGLE_ID="google-id"
EOF
}

# --- Fresh install -----------------------------------------------------------

@test "fresh install: every .env.example key is present, layout and comments kept" {
  merge
  [ "$status" -eq 0 ]
  grep -qx '# Header comment.' "$ROOT/.env"
  grep -qx '# === Optional' "$ROOT/.env"
  grep -qx '# Ceiling on offers.' "$ROOT/.env"
  grep -qx 'DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db"' "$ROOT/.env"
  grep -qx 'EMAIL_FROM="Job Hunt Crew <no-reply@example.local>"' "$ROOT/.env"
  grep -qx 'ANTHROPIC_API_KEY=""' "$ROOT/.env"
  # Commented-out keys with nothing to set stay commented out.
  grep -qx '# LLM_PROVIDER=anthropic' "$ROOT/.env"
  grep -qx '# INGESTION_MAX_OFFERS=25' "$ROOT/.env"
  # Same lines, same order: only the three secrets differ from the example.
  [ "$(grep -vE '^(AUTH_SECRET|INTERNAL_API_SECRET|SETTINGS_ENCRYPTION_KEY)=' "$ROOT/.env")" = \
    "$(grep -vE '^(AUTH_SECRET|INTERNAL_API_SECRET|SETTINGS_ENCRYPTION_KEY)=' "$ROOT/.env.example")" ]
}

@test "fresh install: the three secrets are generated with the expected shape" {
  merge
  [ "$status" -eq 0 ]

  auth=$(value_of AUTH_SECRET)
  [ "$auth" != "dev-auth-secret-change-me" ]
  [ "$(printf '%s' "$auth" | base64 -d | wc -c)" -eq 32 ]

  internal=$(value_of INTERNAL_API_SECRET)
  [ "$internal" != "dev-internal-api-secret" ]
  [[ "$internal" =~ ^[0-9a-f]{64}$ ]]

  # A Fernet key is 32 bytes, url-safe base64.
  fernet=$(value_of SETTINGS_ENCRYPTION_KEY)
  [[ "$fernet" =~ ^[A-Za-z0-9_-]{43}=$ ]]
  [ "$(printf '%s' "$fernet" | tr -- '-_' '+/' | base64 -d | wc -c)" -eq 32 ]
}

@test "fresh install: the report names each generated secret" {
  merge
  [ "$status" -eq 0 ]
  [[ "$output" == *"generated AUTH_SECRET"* ]]
  [[ "$output" == *"generated INTERNAL_API_SECRET"* ]]
  [[ "$output" == *"generated SETTINGS_ENCRYPTION_KEY"* ]]
}

@test "two fresh installs get different secrets" {
  merge
  first=$(value_of SETTINGS_ENCRYPTION_KEY)
  rm "$ROOT/.env"
  merge
  [ "$(value_of SETTINGS_ENCRYPTION_KEY)" != "$first" ]
}

@test "the .env is written readable by its owner only" {
  merge
  [ "$(stat -c '%a' "$ROOT/.env")" = "600" ]
}

@test "answers fill keys, including ones commented out in .env.example" {
  cat >"$BATS_TEST_TMPDIR/answers" <<'EOF'
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-123
EMAIL_FROM=Crew <crew@example.org>
EOF
  merge --answers "$BATS_TEST_TMPDIR/answers"
  [ "$status" -eq 0 ]
  [ "$(value_of LLM_PROVIDER)" = "anthropic" ]
  [ "$(value_of ANTHROPIC_API_KEY)" = "sk-ant-123" ]
  [ "$(value_of EMAIL_FROM)" = "Crew <crew@example.org>" ]
  # The commented line became the active one, in place.
  ! grep -q '^# LLM_PROVIDER=' "$ROOT/.env"
  [ "$(grep -n '^LLM_PROVIDER=' "$ROOT/.env" | cut -d: -f1)" -lt \
    "$(grep -n '^ANTHROPIC_API_KEY=' "$ROOT/.env" | cut -d: -f1)" ]
}

@test "answers with shell-special characters come back verbatim" {
  printf '%s\n' 'ANTHROPIC_API_KEY=a$b"c`d\e' >"$BATS_TEST_TMPDIR/answers"
  merge --answers "$BATS_TEST_TMPDIR/answers"
  [ "$status" -eq 0 ]
  [ "$(value_of ANTHROPIC_API_KEY)" = 'a$b"c`d\e' ]
}

@test "an answer holding both quote kinds is refused" {
  printf '%s\n' "ANTHROPIC_API_KEY=a'b\"c" >"$BATS_TEST_TMPDIR/answers"
  merge --answers "$BATS_TEST_TMPDIR/answers"
  [ "$status" -eq 2 ]
  [[ "$output" == *"ANTHROPIC_API_KEY"* ]]
  [ ! -e "$ROOT/.env" ]
}

# --- Re-run on a complete .env ------------------------------------------------

@test "re-run on a complete .env: every value kept, no secret generated" {
  full_env
  before=$(cat "$ROOT/.env")
  merge
  [ "$status" -eq 0 ]
  [[ "$output" != *"generated"* ]]
  [ "$(value_of DATABASE_URL)" = "postgresql://u:p@db:5432/mine" ]
  [ "$(value_of AUTH_SECRET)" = "my-auth-secret" ]
  [ "$(value_of INTERNAL_API_SECRET)" = "my-internal-secret" ]
  [ "$(value_of SETTINGS_ENCRYPTION_KEY)" = "9Jm0lZb1V8V2dHq6cP3Rk6m9X0u4oJ7c2rTq5H8wYxA=" ]
  [ "$(value_of LLM_PROVIDER)" = "openai" ]
  [ "$(value_of EMAIL_FROM)" = "Me <me@example.org>" ]
  [ "$(value_of AUTH_GOOGLE_ID)" = "google-id" ]
}

@test "re-running on the merged output changes nothing, byte for byte" {
  merge
  first=$(cat "$ROOT/.env")
  merge
  [ "$status" -eq 0 ]
  [[ "$output" != *"generated"* ]]
  [ "$(cat "$ROOT/.env")" = "$first" ]
}

@test "an existing value beats an answer" {
  full_env
  printf 'LLM_PROVIDER=anthropic\nAUTH_SECRET=other\n' >"$BATS_TEST_TMPDIR/answers"
  merge --answers "$BATS_TEST_TMPDIR/answers"
  [ "$status" -eq 0 ]
  [ "$(value_of LLM_PROVIDER)" = "openai" ]
  [ "$(value_of AUTH_SECRET)" = "my-auth-secret" ]
}

@test "an existing empty value stays empty, and an answer fills it" {
  full_env
  merge
  [ "$(value_of ANTHROPIC_API_KEY)" = "" ]
  printf 'ANTHROPIC_API_KEY=sk-ant-9\n' >"$BATS_TEST_TMPDIR/answers"
  merge --answers "$BATS_TEST_TMPDIR/answers"
  [ "$(value_of ANTHROPIC_API_KEY)" = "sk-ant-9" ]
}

# --- Partial .env --------------------------------------------------------------

@test "partial .env: only missing keys are filled" {
  cat >"$ROOT/.env" <<'EOF'
AUTH_SECRET="kept-auth"
EMAIL_FROM="Me <me@example.org>"
EOF
  merge
  [ "$status" -eq 0 ]
  [ "$(value_of AUTH_SECRET)" = "kept-auth" ]
  [ "$(value_of EMAIL_FROM)" = "Me <me@example.org>" ]
  [ "$(value_of DATABASE_URL)" = "postgresql://postgres:postgres@localhost:5432/db" ]
  [[ "$output" != *"generated AUTH_SECRET"* ]]
  [[ "$output" == *"generated INTERNAL_API_SECRET"* ]]
  [[ "$output" == *"generated SETTINGS_ENCRYPTION_KEY"* ]]
}

@test "a published placeholder secret counts as absent and is replaced" {
  cat >"$ROOT/.env" <<'EOF'
AUTH_SECRET="changeme"
INTERNAL_API_SECRET=dev-internal-api-secret
SETTINGS_ENCRYPTION_KEY="SbSkCyNxmIyTmRKah7LjMRn8Lsjf3f8OVkNH7iZoYaw="
EOF
  merge
  [ "$status" -eq 0 ]
  [ "$(value_of AUTH_SECRET)" != "changeme" ]
  [ "$(value_of INTERNAL_API_SECRET)" != "dev-internal-api-secret" ]
  [ "$(value_of SETTINGS_ENCRYPTION_KEY)" != "SbSkCyNxmIyTmRKah7LjMRn8Lsjf3f8OVkNH7iZoYaw=" ]
  [[ "$output" == *"generated SETTINGS_ENCRYPTION_KEY"* ]]
}

# --- Legacy per-package files ------------------------------------------------

@test "legacy files fill missing keys and are reported" {
  cat >"$ROOT/apps/web/.env" <<'EOF'
AUTH_SECRET="legacy-auth"
AUTH_GOOGLE_ID="legacy-google"
EOF
  printf 'DATABASE_URL="postgresql://legacy/db"\n' >"$ROOT/packages/prisma/.env"
  merge
  [ "$status" -eq 0 ]
  [ "$(value_of AUTH_SECRET)" = "legacy-auth" ]
  [ "$(value_of AUTH_GOOGLE_ID)" = "legacy-google" ]
  [ "$(value_of DATABASE_URL)" = "postgresql://legacy/db" ]
  [[ "$output" == *"legacy apps/web/.env"* ]]
  [[ "$output" == *"legacy packages/prisma/.env"* ]]
  [[ "$output" != *"generated AUTH_SECRET"* ]]
}

@test "an existing root value beats a legacy one" {
  full_env
  printf 'AUTH_SECRET="legacy-auth"\nAUTH_GOOGLE_ID="legacy-google"\n' >"$ROOT/apps/web/.env"
  merge
  [ "$status" -eq 0 ]
  [ "$(value_of AUTH_SECRET)" = "my-auth-secret" ]
  [ "$(value_of AUTH_GOOGLE_ID)" = "google-id" ]
  [[ "$output" == *"legacy apps/web/.env"* ]]
}

@test "a legacy placeholder secret is not imported" {
  printf 'AUTH_SECRET="changeme"\nINTERNAL_API_SECRET="dev-internal-api-secret"\n' >"$ROOT/apps/web/.env"
  merge
  [ "$(value_of AUTH_SECRET)" != "changeme" ]
  [ "$(value_of INTERNAL_API_SECRET)" != "dev-internal-api-secret" ]
}

@test "legacy keys .env.example no longer knows are not imported" {
  printf 'DAILY_ANALYSIS_CAP="50"\nS3_ENDPOINT="http://localhost:9000"\n' >"$ROOT/apps/web/.env"
  merge
  [ "$status" -eq 0 ]
  ! grep -q 'DAILY_ANALYSIS_CAP' "$ROOT/.env"
  ! grep -q 'S3_ENDPOINT' "$ROOT/.env"
}

@test "no legacy file: nothing reported as legacy" {
  merge
  [[ "$output" != *"legacy"* ]]
}

# --- Unknown keys --------------------------------------------------------------

@test "keys unknown to .env.example survive the merge, and a re-run" {
  full_env
  printf 'MY_OWN_SETTING="keep me"\nexport OTHER=1\n' >>"$ROOT/.env"
  merge
  [ "$status" -eq 0 ]
  [ "$(value_of MY_OWN_SETTING)" = "keep me" ]
  [ "$(value_of OTHER)" = "1" ]
  first=$(cat "$ROOT/.env")
  merge
  [ "$(cat "$ROOT/.env")" = "$first" ]
  [ "$(grep -c '^MY_OWN_SETTING=' "$ROOT/.env")" -eq 1 ]
}

@test "a duplicated key in .env: the last one wins, as when sourced" {
  printf 'AUTH_GOOGLE_ID="first"\nAUTH_GOOGLE_ID="second"\n' >"$ROOT/.env"
  merge
  [ "$(value_of AUTH_GOOGLE_ID)" = "second" ]
  [ "$(grep -c '^AUTH_GOOGLE_ID=' "$ROOT/.env")" -eq 1 ]
}

# --- Secret generation without openssl --------------------------------------

@test "without openssl, secrets come from a throwaway container" {
  stub="$BATS_TEST_TMPDIR/bin"
  mkdir -p "$stub"
  # Only the tools the merge needs, and a fake docker that logs its call and
  # hands back openssl-shaped output.
  for tool in awk sed tr cat mktemp mv rm chmod dirname grep; do
    ln -s "$(command -v "$tool")" "$stub/$tool"
  done
  cat >"$stub/docker" <<EOF
#!$(command -v bash)
echo "\$*" >>"$BATS_TEST_TMPDIR/docker.log"
case "\$*" in
  *-hex*) echo 00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff ;;
  *) echo 'q83vEjRWeJCrze8SNFZ4kKvN7xI0VniQq83vEjRWeJA=' ;;
esac
EOF
  chmod +x "$stub/docker"
  PATH="$stub" run "$(command -v bash)" "$MERGE" --root "$ROOT"
  [ "$status" -eq 0 ]
  grep -q 'run --rm alpine/openssl rand' "$BATS_TEST_TMPDIR/docker.log"
  [ "$(value_of INTERNAL_API_SECRET)" = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff" ]
  [ "$(value_of SETTINGS_ENCRYPTION_KEY)" = "q83vEjRWeJCrze8SNFZ4kKvN7xI0VniQq83vEjRWeJA=" ]
}

@test "without openssl or docker, the merge fails before writing anything" {
  stub="$BATS_TEST_TMPDIR/bin"
  mkdir -p "$stub"
  for tool in awk sed tr cat mktemp mv rm chmod dirname grep; do
    ln -s "$(command -v "$tool")" "$stub/$tool"
  done
  PATH="$stub" run "$(command -v bash)" "$MERGE" --root "$ROOT"
  [ "$status" -ne 0 ]
  [[ "$output" == *"openssl"* ]]
  [ ! -e "$ROOT/.env" ]
}

# --- Arguments --------------------------------------------------------------------

@test "a missing .env.example is an error" {
  rm "$ROOT/.env.example"
  merge
  [ "$status" -eq 2 ]
  [[ "$output" == *".env.example"* ]]
}

@test "a missing answers file is an error" {
  merge --answers "$BATS_TEST_TMPDIR/nope"
  [ "$status" -eq 2 ]
  [ ! -e "$ROOT/.env" ]
}
