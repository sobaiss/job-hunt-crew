generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js (Auth.js) Prisma adapter models.
// See https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  cvVersions    CVVersion[]
  ingestionJobs IngestionJob[]
  analyses      Analysis[]
  scouts        Scout[]
  applications  Application[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum CVFileType {
  PDF
  DOCX
  MD
  TXT
}

// Status of a CVVersion's Markdown rendition (its `markdownContent`). See
// docs/adr/0001-cv-matching-uses-markdown-rendition.md. This is the sole
// status on the CV path; the structured-data extraction it replaced (and its
// `CVParseStatus`) were retired in #21.
enum CVConversionStatus {
  PENDING
  CONVERTING
  CONVERTED
  FAILED
}

model CVVersion {
  id               String             @id @default(cuid())
  userId           String
  label            String
  fileKey          String
  fileName         String
  fileType         CVFileType
  fileSizeBytes    Int
  isDefault        Boolean            @default(false)
  markdownContent  String?
  conversionStatus CVConversionStatus @default(PENDING)
  conversionError  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses           Analysis[]
  ingestionJobs      IngestionJob[]
  scouts             Scout[]
  generatedDocuments GeneratedDocument[]
  applications       Application[]

  @@index([userId])
}

enum JobOfferSourceSite {
  LINKEDIN
  INDEED
  FRANCE_TRAVAIL
  WTTJ
  GLASSDOOR
  OTHER
}

enum JobOfferExtractionStatus {
  PENDING
  SCRAPING
  SCRAPED
  EXTRACTING
  READY
  FAILED
}

// Globally deduplicated by sourceUrl — not user-owned. See PRD Section 6.
model JobOffer {
  id               String                   @id @default(cuid())
  sourceUrl        String                   @unique
  sourceSite       JobOfferSourceSite
  title            String?
  company          String?
  location         String?
  postedAt         DateTime?
  rawContentKey    String?
  structuredData   Json?
  extractionStatus JobOfferExtractionStatus @default(PENDING)
  errorMessage     String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  ingestionJobOffers IngestionJobOffer[]
  analyses           Analysis[]
  generatedDocuments GeneratedDocument[]
  applications       Application[]
}

enum IngestionMode {
  SINGLE_URL
  LISTING_URL
  SITE_SEARCH
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
}

// User-scoped access-control boundary. See PRD Section 6.
model IngestionJob {
  id                     String             @id @default(cuid())
  userId                 String
  mode                   IngestionMode
  cvVersionId            String?
  scoutRunId             String?
  inputUrl               String?
  siteConfigId           String?
  filters                Json?
  maxOffers              Int                @default(25)
  status                 IngestionJobStatus @default(PENDING)
  discoveredCount        Int                @default(0)
  scrapedCount           Int                @default(0)
  failedCount            Int                @default(0)
  quotaSkippedCount      Int                @default(0)
  alreadySeenCount       Int                @default(0)
  runLimitSkippedCount   Int                @default(0)
  extractionSkippedCount Int                @default(0)
  errorMessage           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvVersion      CVVersion?          @relation(fields: [cvVersionId], references: [id], onDelete: Cascade)
  scoutRun       ScoutRun?           @relation(fields: [scoutRunId], references: [id], onDelete: Cascade)
  jobOffers      IngestionJobOffer[]
  analyses       Analysis[]
  pipelineEvents PipelineEvent[]

  @@index([userId])
  @@index([scoutRunId])
}

model IngestionJobOffer {
  id             String   @id @default(cuid())
  ingestionJobId String
  jobOfferId     String
  createdAt      DateTime @default(now())

  ingestionJob IngestionJob @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)
  jobOffer     JobOffer     @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@unique([ingestionJobId, jobOfferId])
  @@index([jobOfferId])
}

enum SiteConfigSiteKey {
  LINKEDIN
  INDEED
  FRANCE_TRAVAIL
  WTTJ
  GLASSDOOR
}

enum SiteConfigIntegrationType {
  HTML_SCRAPE
  OFFICIAL_API
}

enum SiteConfigAntiBotRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Data-driven per-site adapter config, seeded for the 5 sites. See PRD Section 6 / 8.5.
model SiteConfig {
  id                  String                     @id @default(cuid())
  siteKey             SiteConfigSiteKey          @unique
  displayName         String
  baseUrl             String
  searchUrlTemplate   String?
  filterParamMapping  Json?
  listItemSelector    String?
  offerLinkSelector   String?
  offerTitleSelector  String?
  integrationType     SiteConfigIntegrationType
  apiBaseUrl          String?
  requiresJsRendering Boolean                    @default(false)
  antiBotRiskLevel    SiteConfigAntiBotRiskLevel
  enabled             Boolean                    @default(true)
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
}

enum AnalysisStatus {
  PENDING
  QUEUED
  RUNNING_CREW
  AWAITING_RESULT
  PERSISTING
  COMPLETED
  FAILED
}

// User-scoped access-control boundary. See PRD Section 6 / 8.6.
model Analysis {
  id                       String         @id @default(cuid())
  userId                   String
  jobOfferId               String
  cvVersionId              String
  ingestionJobId           String?
  // Denormalised (like userId / jobOfferId / cvVersionId) so per-Scout
  // queries and cross-run dedup avoid a two-hop join. Null for a manual
  // analysis. See issue #54 / docs/adr/0004.
  scoutId                  String?
  status                   AnalysisStatus @default(PENDING)
  s3ResultKey              String?
  matchScore               Int?
  resultJSON               Json?
  errorMessage             String?
  stepFunctionExecutionArn String?
  requestedAt              DateTime       @default(now())
  startedAt                DateTime?
  completedAt              DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOffer           JobOffer            @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  cvVersion          CVVersion           @relation(fields: [cvVersionId], references: [id], onDelete: Cascade)
  ingestionJob       IngestionJob?       @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)
  pipelineEvents     PipelineEvent[]
  generatedDocuments GeneratedDocument[]
  application        Application?

  @@index([userId])
  @@index([jobOfferId])
  @@index([cvVersionId])
  @@index([ingestionJobId])
  @@index([scoutId])
}

// Observability/debug trail across the ingestion + analysis pipelines. See
// PRD Section 6 / M6-T3. Not user-scoped access-control — purely additive
// logging, so a missing analysisId/ingestionJobId pair (e.g. a Fargate step
// running with only one of the two in context) is expected, not an error.
model PipelineEvent {
  id             String   @id @default(cuid())
  analysisId     String?
  ingestionJobId String?
  stage          String
  status         String
  message        String?
  createdAt      DateTime @default(now())

  analysis     Analysis?     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  ingestionJob IngestionJob? @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([ingestionJobId])
}

enum ScoutStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// A saved, self-running search + match configuration owned by one Candidate.
// See issue #52 / docs/adr/0004. Slice 1 (#53) is CRUD only — Scouts do not run
// yet. The base-CV FK is `onDelete: Restrict`: services/api rejects deleting a
// CVVersion any Scout still references, naming the referencing Scouts.
model Scout {
  id             String      @id @default(cuid())
  userId         String
  label          String
  cvVersionId    String
  // string[] of SiteConfigSiteKey values — the sites this Scout searches.
  targetSiteKeys Json
  // Same shape as IngestionJob.filters: keywords, location, postedWithin,
  // contractType, remote, experienceLevel.
  filters        Json
  matchThreshold Int         @default(70)
  status         ScoutStatus @default(ACTIVE)
  lastRunAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvVersion CVVersion  @relation(fields: [cvVersionId], references: [id], onDelete: Restrict)
  runs      ScoutRun[]

  @@index([userId])
  @@index([cvVersionId])
}

// Mirrors IngestionJobStatus: a Scout run is scheduler/user-triggered, spans
// one IngestionJob per targeted site, and is the anchor for run history and
// per-Scout stats. See issue #54 / docs/adr/0004 (why this is a real aggregate
// row, unlike ADR 0002's derived multi-offer batch).
enum ScoutRunStatus {
  PENDING
  RUNNING
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
}

model ScoutRun {
  id                      String         @id @default(cuid())
  scoutId                 String
  status                  ScoutRunStatus @default(PENDING)
  sitesQueried            Int            @default(0)
  siteUnavailableCount    Int            @default(0)
  offersDiscovered        Int            @default(0)
  offersAnalysed          Int            @default(0)
  relevantCount           Int            @default(0)
  documentsGeneratedCount Int            @default(0)
  failedCount             Int            @default(0)
  capSkippedCount         Int            @default(0)
  alreadySeenCount        Int            @default(0)
  runLimitSkippedCount    Int            @default(0)
  errorMessage            String?
  startedAt               DateTime?
  finishedAt              DateTime?
  createdAt               DateTime       @default(now())

  scout         Scout          @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  ingestionJobs IngestionJob[]

  @@index([scoutId])
}

enum GeneratedDocumentType {
  COVER_LETTER
  TAILORED_CV
}

enum GeneratedDocumentStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

// A derived artifact of an Analysis — a cover letter or a tailored CV — never
// a mutation of the base CVVersion. See issue #58 / docs/adr/0003 (a future
// slice). "Generate documents" on a relevant find creates one row per type;
// "Regenerate" will create a fresh row and set the old row's
// supersededById, so only the newest non-superseded row per
// (analysisId, type) is shown — that flow is not wired up yet.
model GeneratedDocument {
  id              String                  @id @default(cuid())
  type            GeneratedDocumentType
  analysisId      String
  // Denormalised (like Analysis.jobOfferId/cvVersionId) so generation/
  // download queries avoid a join through Analysis.
  jobOfferId      String
  cvVersionId     String
  // Denormalised attribution to the Scout run that produced the underlying
  // find; null for a document generated off a manual analysis.
  scoutRunId      String?
  status          GeneratedDocumentStatus @default(PENDING)
  markdownContent String?
  s3Key           String?
  errorMessage    String?
  supersededById  String?                 @unique
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  analysis  Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  jobOffer  JobOffer  @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  cvVersion CVVersion @relation(fields: [cvVersionId], references: [id], onDelete: Restrict)

  @@index([analysisId])
  @@index([jobOfferId])
  @@index([cvVersionId])
  @@index([scoutRunId])
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// Created lazily — on the first "Generate documents" or "Mark as applied" for
// a given Analysis — never eagerly for every relevant find. See issue #59 /
// docs/adr/0004. `analysisId` is unique: at most one Application per
// Analysis, so two Scouts finding the same offer (each with its own
// Analysis) can each become their own Application. `status`/`appliedAt` are
// denormalised onto the row and kept in sync on every StatusEvent append
// (mirrors Scout.lastRunAt) rather than derived by query on every read; the
// StatusEvent list remains the append-only source of truth for the timeline.
// `cvVersionId` FK is `onDelete: Restrict`, like GeneratedDocument's.
model Application {
  id               String            @id @default(cuid())
  userId           String
  analysisId       String            @unique
  jobOfferId       String
  cvVersionId      String
  // Denormalised, like Analysis.scoutId; null for a manually-tracked Analysis.
  scoutId          String?
  // Denormalised references to the GeneratedDocument rows used for this
  // Application, if any were generated before applying. Not a DB-enforced FK
  // (GeneratedDocument.supersededById already makes the "latest" row a
  // moving target) — the API resolves and validates ownership on write.
  coverLetterDocId String?
  tailoredCvDocId  String?
  status           ApplicationStatus @default(DRAFT)
  appliedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis     Analysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  jobOffer     JobOffer      @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  cvVersion    CVVersion     @relation(fields: [cvVersionId], references: [id], onDelete: Restrict)
  statusEvents StatusEvent[]

  @@index([userId])
  @@index([jobOfferId])
  @@index([cvVersionId])
  @@index([scoutId])
}

// Append-only child of Application — one row per status transition, with an
// optional note and an effective date the Candidate can back-date. The
// Application's current `status` is always the latest event's status.
model StatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  note          String?
  effectiveDate DateTime
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}
