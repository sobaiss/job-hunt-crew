# job-hunt-crew: the one environment file for the whole repo.
#
# Copy to `.env` at the repo root (gitignored). Everything reads it:
# docker-compose (interpolation, and `env_file` for `api` and `worker`),
# `pnpm dev` / `next build` (apps/web/next.config.ts), `make migrate`,
# `make seed`, `make worker`, `make web-up`, `make verify-sites`.
# There are no per-package .env files any more.
#
# Container wiring (Postgres, MinIO, ElasticMQ hostnames and credentials, queue
# URLs) is set by docker-compose.yml and the Makefile, not here.

# =============================================================================
# Required
# =============================================================================

# Postgres as seen from the host: Prisma CLI (`make migrate`, `make seed`),
# `make worker` and the Python test suites. Containers use their own URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_hunt_crew?schema=public"

# =============================================================================
# Generated by setup
# =============================================================================
# `make setup` generates each of these once and never regenerates it. Empty,
# docker compose refuses to start ("run make setup").

# Signs the Auth.js session cookie. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Shared by apps/web (sent on every call to the API) and the `api` container
# (checked on every call). One value, read by both. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=""

# Fernet key encrypting the LLM API keys saved from Admin -> LLM providers
# (docs/adr/0024). The API, the worker and `make worker` must share it: a new
# one makes the saved keys unreadable. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=""

# =============================================================================
# Optional
# =============================================================================

# --- LLM provider (environment fallback; Admin -> LLM providers overrides it)
# anthropic | openai | openrouter | huggingface | ollama. Leave it commented
# out rather than empty when unused: unset, the compose services default to
# ollama and host processes (`make worker`) to anthropic.
# LLM_PROVIDER=anthropic
# Empty: the provider's default model.
LLM_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
HF_TOKEN=""
# Only for ollama. From the containers, a host Ollama is
# http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=""

# --- Email (magic-link sign-in)
# Empty: no email is sent; the magic-link URL is logged to the web server's
# console instead.
EMAIL_SERVER=""
EMAIL_FROM="Job Hunt Crew <no-reply@job-hunt-crew.local>"

# --- OAuth sign-in (read by Auth.js by name)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# --- Job sources needing credentials. Remotive, LinkedIn and HelloWork need
# none. Without these, France Travail / Adzuna searches fail as "not configured".
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""
# Free key pair from https://developer.adzuna.com
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# =============================================================================
# Advanced (uncomment to change; the value shown is the default)
# =============================================================================

# --- Web
# Where apps/web reaches the API. Compose services override it as needed.
# API_BASE_URL="http://localhost:8000"

# --- API
# Ceiling on the offers one "Analyse several offers" run analyses.
# INGESTION_MAX_OFFERS=25
# "Run now" on a Scout is allowed once per this many seconds (0 disables it).
# SCOUT_RUN_RATE_LIMIT_SECONDS=3600

# --- Scouts
# UTC hour every active Scout is due each day.
# SCOUT_SCHEDULE_HOUR_UTC=6
# How often the worker checks for due Scouts.
# SCOUT_SCHEDULE_TICK_SECONDS=60
# A Scout run still going after this long counts as stuck.
# SCOUT_RUN_STUCK_AFTER_MINUTES=20
# Most offers one Scout run sends to Analysis.
# SCOUT_MAX_ANALYSES_PER_RUN=20

# --- Analyses
# An Analysis picked up and silent for this long counts as blocked.
# ANALYSIS_STUCK_AFTER_MINUTES=15

# --- Worker
# local (whole AnalysisWorkflow in-process) | stepfunctions (needs the
# `stepfunctions-local` service, the host lambda_shim and the ARN below).
# WORKER_ANALYSIS_MODE=local
# ANALYSIS_WORKFLOW_STATE_MACHINE_ARN=""
# Queues `make worker` drains (comma-separated); default: all five.
# WORKER_QUEUES=cv-conversion,ingestion-intake,analysis-intake,scout-intake,generation-intake
# Long-poll wait per receive, in seconds.
# WORKER_WAIT_SECONDS=5
# Set to 1 to drain what is queued, then exit (`make worker-once` does this).
# WORKER_RUN_ONCE=

# --- Scraping
# SCRAPER_MIN_DELAY_SECONDS=1.0
# SCRAPER_MAX_RETRIES=3
# SCRAPER_TIMEOUT_SECONDS=30
# SCRAPER_USER_AGENT="<a current desktop Chrome user agent>"
# SCRAPER_ACCEPT_LANGUAGE="fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7"
# 0 switches the headless-browser tier off.
# BROWSER_FETCH_ENABLED=1
# France Travail OAuth scope.
# FRANCE_TRAVAIL_SCOPE="api_offresdemploiv2 o2dsoffre"
