DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_hunt_crew?schema=public"

# openssl rand -base64 32
AUTH_SECRET="changeme"

# services/api (M7): sole owner of Postgres/S3/SQS. Secret must match the
# `api` container's INTERNAL_API_SECRET in docker-compose.yml.
API_BASE_URL="http://localhost:8000"
INTERNAL_API_SECRET="dev-internal-api-secret"

# Optional in dev: falls back to nodemailer's jsonTransport (no real send)
# when unset, and logs the magic-link URL to the server console instead.
EMAIL_SERVER=""
EMAIL_FROM="Job Hunt Crew <no-reply@job-hunt-crew.local>"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# S3-compatible object storage. Points at the local docker-compose MinIO
# service by default; swap for real AWS S3 (unset S3_ENDPOINT/FORCE_PATH_STYLE,
# set S3_ACCESS_KEY_ID/SECRET via Secrets Manager-injected env) in production.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="job-hunt-crew"
S3_FORCE_PATH_STYLE="true"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# SQS-compatible queue. Points at the local docker-compose ElasticMQ emulator
# by default; swap for a real AWS SQS queue URL (unset SQS_ENDPOINT, set
# SQS_ACCESS_KEY_ID/SECRET via Secrets Manager-injected env) in production.
SQS_ENDPOINT="http://localhost:9324"
SQS_REGION="us-east-1"
SQS_ANALYSIS_INTAKE_QUEUE_URL="http://localhost:9324/000000000000/analysis-intake"
SQS_ACCESS_KEY_ID="x"
SQS_SECRET_ACCESS_KEY="x"

# Cost-control guardrails (PRD Section 11), both configurable without a code
# change.
INGESTION_MAX_OFFERS="25"
DAILY_ANALYSIS_CAP="50"
# Scout cost-bounded matching (issue #55): the per-run analysis ceiling a
# Scout's discovered offers are pre-ranked and cut down to, on top of the
# shared DAILY_ANALYSIS_CAP above.
SCOUT_MAX_ANALYSES_PER_RUN="20"
# Daily autonomous scheduling (issue #57): the fixed UTC hour every active
# Scout is due. Read by services/scout/services/ingestion's local worker, not
# by apps/web itself — listed here for reference alongside the other Scout
# cost/schedule knobs.
SCOUT_SCHEDULE_HOUR_UTC="6"
